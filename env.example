# Copy to .env and fill in values. Never commit .env.

NODE_ENV=production
ENVIRONMENT=production
PORT=8000
APP_NAME=Recycool

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

JWT_ACCESS_TOKEN_EXPIRES=1h
JWT_REFRESH_TOKEN_EXPIRES=24h

REDIS_HOST=
REDIS_PORT=6379
REDIS_URL=
REDIS_PASSWORD=
REDIS_USER=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
# Secret hash configured in Flutterwave dashboard → Webhooks → Secret Hash
FLW_WEBHOOK_HASH=

RESEND_API_KEY=

# Optional: comma-separated web origins; * is OK when clients are native apps only
CORS_ORIGIN=*

# Optional: cap on failed requests per IP per 15m window (production /api rate limit)
API_RATE_LIMIT_MAX=400
